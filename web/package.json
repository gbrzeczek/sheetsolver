{
  "name": "sheetsolver-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Sheetsolver web UI (Stage 7). See DESIGN.md.",
  "scripts": {
    "openapi": "cargo run -q -p api -- --print-openapi > openapi.json",
    "gen": "openapi-typescript openapi.json -o src/lib/api/schema.d.ts && node scripts/gen-fields.mjs",
    "dev": "npm run gen && vite",
    "build": "npm run gen && vite build",
    "check": "npm run gen && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "npm run gen && vitest run",
    "e2e": "npm run build && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "22.19.1",
    "openapi-typescript": "7.13.0",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  }
}
